{
  "expo": {
    "name": "Pet Royale",
    "slug": "pet-royale-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petroyalemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dosie.petroyale",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dosie.petroyale",
      "googleServicesFile": "./google-services.json",
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#051F42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#051F42"
        }
      ],
       [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 26 }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-startup.png",
          "imageWidth": 386,
          "backgroundColor": "#051F42"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pet Royale needs access to your photos so you can add a picture of your pet or your profile.",
          "cameraPermission": "Pet Royale needs your camera so you can take a picture of your pet or your profile.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cea9a7f-2e5d-4a62-912f-96e5ad1852d0"
      }
    },
    "owner": "dosie",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cea9a7f-2e5d-4a62-912f-96e5ad1852d0"
    }
  }
}
